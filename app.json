{
  "expo": {
    "name": "♥️ 𝑅𝑀𝒦",
    "slug": "rmk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/androidLogo1.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/androidLogo1.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "com.abdul2708.tasksfrontendts",
      "useNextNotificationsApi": true,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/androidLogo1.png",
        "backgroundColor": "#000000"
      }
    },
    "ios": {
      "bundleIdentifier": "com.abdul2708.tasksfrontendts",
      "supportsTablet": true
    },
    "extra": {
      "eas": {
        "projectId": "9018bc69-22dd-4d27-8d53-4fd7da4e3ca0"
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/images/androidLogo1.png",
          "color": "#00000000",
          "vibrationPattern": [0, 100, 50, 300, 100, 300],
          "sounds": ["./assets/audio/notification.wav"]
        }
      ],
      ["expo-image-picker"],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera",
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone",
          "recordAudioAndroid": true
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "experiments": {
      "disableFontScaling": true
    },
    "owner": "rehman2708"
  }
}
